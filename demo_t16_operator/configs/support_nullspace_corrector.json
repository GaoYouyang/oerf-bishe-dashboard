{
  "name": "t16_support_nullspace_corrector_v2b",
  "base_experiment_config": "independent_dual_support.json",
  "correction_modes": ["free_correction", "nullspace_correction"],
  "correction_cap_ratio": 0.5,
  "model": {
    "hidden_channels": 8,
    "n_modes": [4, 6, 6],
    "n_layers": 2
  },
  "training": {
    "device": "cpu",
    "batch_size": 4,
    "epochs": 30,
    "learning_rate": 0.002,
    "weight_decay": 0.0001,
    "lambda_gradient": 0.12,
    "lambda_support": 0.015,
    "lambda_query": 0.03,
    "lambda_boundary": 0.02,
    "lambda_correction_norm": 0.001,
    "early_stop_patience": 5
  }
}
