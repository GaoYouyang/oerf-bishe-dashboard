    "selection_standard_error": "sample_standard_deviation_ddof_1_of_inner_trajectory_MSE_values_divided_by_sqrt_number_of_inner_trajectories",
    "one_standard_error_rule": "find_lambda_with_minimum_mean_MSE_then_choose_the_largest_lambda_whose_mean_MSE_is_at_most_that_minimum_plus_the_standard_error_at_the_minimizing_lambda",
    "minimum_mean_tie_break": "largest_lambda",
