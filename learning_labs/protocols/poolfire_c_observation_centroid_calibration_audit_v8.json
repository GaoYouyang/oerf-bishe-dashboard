    "coefficient_shape": [
      3,
      5
    ],
    "total_scalar_parameters": 15,
    "coefficient_dtype": "float64",
    "constant_column_is_penalized": true,
    "lambda_to_infinity_limit": "predicted_teacher_centroid_equals_raw_centroid",
    "standardization": "training_trajectories_only_per_axis_nonconstant_design_mean_and_population_standard_deviation",
    "standard_deviation_floor": 1e-12,
    "below_floor_feature_policy": "center_and_set_standardized_column_to_zero_without_removing_or_reordering_it",
    "trajectory_balanced_loss": "each_training_trajectory_total_weight_is_one_over_number_of_training_trajectories_and_each_frame_splits_that_weight_equally",
    "objective": "trajectory_equal_weighted_mean_squared_normalized_centroid_residual_over_all_three_axes_plus_one_shared_lambda_times_squared_frobenius_norm_of_all_three_Theta_rows_including_constants",
    "solver": "float64_symmetric_eigendecomposition_with_nonnegative_eigenvalue_check",
    "prediction_clipping": "none",
    "out_of_field_centroid_prediction": "fail_that_complete_trajectory",
    "fallback_gate": "none_in_v8",
    "no_neural_network": true,
    "shared_lambda_across_all_axes": true,
    "cross_axis_centroid_or_equalization_terms_forbidden": true,
    "no_axis_specific_model_family_selection": true
  },
  "regularization_selection": {
