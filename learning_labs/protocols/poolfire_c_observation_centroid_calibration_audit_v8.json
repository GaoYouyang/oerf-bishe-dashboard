  "model_contract": {
    "family": "axis_structured_multioutput_affine_residual_ridge",
    "prediction": "for_axis_j_predicted_teacher_centroid_j=raw_centroid_j+half_extent_j*([1,u_j,d_j,q_xz,q_yz]@Theta_j)",
    "target": "(teacher_centroid-raw_centroid)/half_extent_xyz",
    "per_axis_design_order": [
      "constant",
      "raw_centroid_centered_scaled_same_axis",
      "equalized_minus_raw_centroid_scaled_same_axis",
      "log_unit_component_energy_x_over_z",
      "log_unit_component_energy_y_over_z"
    ],
